# Copiez ce fichier sous le nom .env.local puis remplacez les valeurs.
# (Sur Vercel, ces mêmes lignes se saisissent dans Settings > Environment Variables.)

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Supabase > Project Settings > API Keys > « Publishable key » (commence par sb_publishable_)
# (l'ancienne clé « anon public » fonctionne aussi)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Facultatif : clé Google Books, pour ne pas être limité en nombre de recherches
GOOGLE_BOOKS_API_KEY=
